rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasAll([
            'name',
            'email',
            'phone',
            'location',
            'profileImage',
            'rating',
            'reviewCount',
            'online',
            'createdAt',
            'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'name',
            'email',
            'phone',
            'location',
            'profileImage',
            'rating',
            'reviewCount',
            'online',
            'createdAt',
            'updatedAt'
          ]) &&
          data.name is string &&
          data.name.size() <= 100 &&
          data.email is string &&
          data.email.size() <= 254 &&
          data.phone is string &&
          data.phone.size() <= 30 &&
          data.location is string &&
          data.location.size() <= 120 &&
          data.profileImage is string &&
          data.profileImage.size() <= 2048 &&
          data.rating is number &&
          data.reviewCount is int &&
          data.online is bool &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) &&
        validProfile(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) &&
        validProfile(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'phone',
          'location',
          'profileImage',
          'updatedAt'
        ]) &&
        request.resource.data.profileImage is string &&
        request.resource.data.profileImage.size() <= 2048 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /favorites/{productId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time &&
          exists(/databases/$(database)/documents/products/$(productId));
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /cartItems/{productId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasAll([
            'productId',
            'sellerId',
            'sellerName',
            'productTitle',
            'productImage',
            'price',
            'addedAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'productId',
            'sellerId',
            'sellerName',
            'productTitle',
            'productImage',
            'price',
            'addedAt'
          ]) &&
          request.resource.data.productId == productId &&
          exists(/databases/$(database)/documents/products/$(productId)) &&
          get(/databases/$(database)/documents/products/$(productId)).data.status == 'Active' &&
          get(/databases/$(database)/documents/products/$(productId)).data.sellerId != uid &&
          request.resource.data.sellerId ==
            get(/databases/$(database)/documents/products/$(productId)).data.sellerId &&
          request.resource.data.sellerName ==
            get(/databases/$(database)/documents/products/$(productId)).data.sellerName &&
          request.resource.data.productTitle ==
            get(/databases/$(database)/documents/products/$(productId)).data.title &&
          request.resource.data.price ==
            get(/databases/$(database)/documents/products/$(productId)).data.price &&
          request.resource.data.productImage ==
            (
              get(/databases/$(database)/documents/products/$(productId)).data.imageUrls.size() > 0
                ? get(/databases/$(database)/documents/products/$(productId)).data.imageUrls[0]
                : ''
            ) &&
          request.resource.data.productImage is string &&
          request.resource.data.productImage.size() <= 2048 &&
          request.resource.data.addedAt == request.time;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if signedIn() &&
          request.resource.data.keys().hasAll([
            'type',
            'title',
            'description',
            'actorId',
            'relatedId',
            'eventId',
            'isRead',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'type',
            'title',
            'description',
            'actorId',
            'relatedId',
            'eventId',
            'isRead',
            'createdAt'
          ]) &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 100 &&
          request.resource.data.description is string &&
          request.resource.data.description.size() <= 300 &&
          request.resource.data.relatedId is string &&
          request.resource.data.eventId is string &&
          request.resource.data.isRead == false &&
          request.resource.data.createdAt == request.time &&
          (
            (
              request.resource.data.type == 'message' &&
              request.resource.data.relatedId.size() > 0 &&
              request.resource.data.eventId.size() > 0 &&
              existsAfter(
                /databases/$(database)/documents/conversations/$(request.resource.data.relatedId)/messages/$(request.resource.data.eventId)
              ) &&
              getAfter(
                /databases/$(database)/documents/conversations/$(request.resource.data.relatedId)/messages/$(request.resource.data.eventId)
              ).data.senderId == request.auth.uid &&
              getAfter(
                /databases/$(database)/documents/conversations/$(request.resource.data.relatedId)/messages/$(request.resource.data.eventId)
              ).data.receiverId == uid &&
              request.auth.uid in getAfter(
                /databases/$(database)/documents/conversations/$(request.resource.data.relatedId)
              ).data.participantIds &&
              uid in getAfter(
                /databases/$(database)/documents/conversations/$(request.resource.data.relatedId)
              ).data.participantIds
            ) ||
            (
              request.resource.data.type == 'offer' &&
              request.resource.data.relatedId == request.resource.data.eventId &&
              existsAfter(
                /databases/$(database)/documents/offers/$(request.resource.data.eventId)
              ) &&
              (
                (
                  !exists(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ) &&
                  getAfter(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.buyerId == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.sellerId == uid &&
                  getAfter(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.status == 'Pending'
                ) ||
                (
                  exists(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ) &&
                  get(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.status == 'Pending' &&
                  getAfter(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.sellerId == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.buyerId == uid &&
                  getAfter(
                    /databases/$(database)/documents/offers/$(request.resource.data.eventId)
                  ).data.status in ['Accepted', 'Rejected']
                )
              )
            ) ||
            (
              request.resource.data.type == 'order' &&
              request.resource.data.relatedId == request.resource.data.eventId &&
              existsAfter(
                /databases/$(database)/documents/orders/$(request.resource.data.eventId)
              ) &&
              (
                (
                  !exists(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ) &&
                  getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ).data.buyerId == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ).data.sellerId == uid &&
                  getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ).data.status == 'Pending'
                ) ||
                (
                  exists(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ) &&
                  get(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ).data.status != getAfter(
                    /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                  ).data.status &&
                  (
                    (
                      getAfter(
                        /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                      ).data.buyerId == request.auth.uid &&
                      getAfter(
                        /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                      ).data.sellerId == uid
                    ) ||
                    (
                      getAfter(
                        /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                      ).data.sellerId == request.auth.uid &&
                      getAfter(
                        /databases/$(database)/documents/orders/$(request.resource.data.eventId)
                      ).data.buyerId == uid
                    )
                  )
                )
              )
            )
          );
        allow update: if isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead'
          ]) &&
          request.resource.data.isRead is bool;
        allow delete: if isOwner(uid);
      }
    }

    function validProduct(data) {
      return data.keys().hasAll([
            'sellerId',
            'sellerName',
            'sellerLocation',
            'sellerProfileImage',
            'sellerRating',
            'sellerReviewCount',
            'title',
            'description',
            'price',
            'category',
            'condition',
            'location',
            'imageUrls',
            'status',
            'views',
            'createdAt',
            'updatedAt'
          ]) &&
          data.keys().hasOnly([
            'sellerId',
            'sellerName',
            'sellerLocation',
            'sellerProfileImage',
            'sellerRating',
            'sellerReviewCount',
            'title',
            'description',
            'price',
            'category',
            'condition',
            'location',
            'imageUrls',
            'status',
            'views',
            'createdAt',
            'updatedAt'
          ]) &&
          data.sellerId is string &&
          data.sellerName is string &&
          data.sellerName.size() <= 100 &&
          data.sellerLocation is string &&
          data.sellerLocation.size() <= 120 &&
          data.sellerProfileImage is string &&
          data.sellerProfileImage.size() <= 2048 &&
          data.sellerRating is number &&
          data.sellerReviewCount is int &&
          data.title is string &&
          data.title.size() > 0 &&
          data.title.size() <= 120 &&
          data.description is string &&
          data.description.size() > 0 &&
          data.description.size() <= 4000 &&
          data.price is number &&
          data.price > 0 &&
          data.price <= 100000000 &&
          data.category is string &&
          data.category.size() > 0 &&
          data.category.size() <= 60 &&
          data.condition is string &&
          data.condition.size() > 0 &&
          data.condition.size() <= 40 &&
          data.location is string &&
          data.location.size() <= 120 &&
          data.imageUrls is list &&
          data.imageUrls.size() <= 5 &&
          data.status in ['Active', 'Sold', 'Inactive'] &&
          data.views is int &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.sellerId == request.auth.uid &&
        validProduct(request.resource.data) &&
        request.resource.data.status == 'Active' &&
        request.resource.data.views == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if signedIn() &&
        (
          (
            resource.data.sellerId == request.auth.uid &&
            validProduct(request.resource.data) &&
            request.resource.data.sellerId == resource.data.sellerId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'title',
              'description',
              'price',
              'category',
              'condition',
              'location',
              'imageUrls',
              'status',
              'updatedAt'
            ]) &&
            request.resource.data.updatedAt == request.time
          ) ||
          (
            request.auth.uid != resource.data.sellerId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'views'
            ]) &&
            request.resource.data.views == resource.data.views + 1
          )
        );
      allow delete: if signedIn() &&
        resource.data.sellerId == request.auth.uid;
    }

    function isConversationParticipant(conversationId) {
      return signedIn() &&
        request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantIds;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() &&
        (
          !exists(
            /databases/$(database)/documents/conversations/$(conversationId)
          ) ||
          request.auth.uid in resource.data.participantIds
        );
      allow list: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'productId',
          'buyerId',
          'sellerId',
          'participantIds',
          'buyerName',
          'sellerName',
          'buyerAvatar',
          'sellerAvatar',
          'productTitle',
          'productPrice',
          'productImage',
          'lastMessage',
          'lastMessageAt',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'productId',
          'buyerId',
          'sellerId',
          'participantIds',
          'buyerName',
          'sellerName',
          'buyerAvatar',
          'sellerAvatar',
          'productTitle',
          'productPrice',
          'productImage',
          'lastMessage',
          'lastMessageAt',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.sellerId != request.auth.uid &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.hasAll([
          request.resource.data.buyerId,
          request.resource.data.sellerId
        ]) &&
        exists(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ) &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.sellerId == request.resource.data.sellerId &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.status == 'Active' &&
        request.resource.data.buyerName is string &&
        request.resource.data.buyerName.size() <= 100 &&
        request.resource.data.sellerName is string &&
        request.resource.data.sellerName.size() <= 100 &&
        request.resource.data.buyerAvatar is string &&
        request.resource.data.sellerAvatar is string &&
        request.resource.data.productTitle is string &&
        request.resource.data.productTitle.size() <= 120 &&
        request.resource.data.productPrice is number &&
        request.resource.data.productPrice > 0 &&
        request.resource.data.productImage is string &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.lastMessageAt == request.time &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'updatedAt'
        ]) &&
        request.resource.data.lastMessage is string &&
        request.resource.data.lastMessage.size() > 0 &&
        request.resource.data.lastMessage.size() <= 1000 &&
        request.resource.data.lastMessageAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId) &&
          request.resource.data.keys().hasOnly([
            'senderId',
            'receiverId',
            'text',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'senderId',
            'receiverId',
            'text',
            'createdAt'
          ]) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.receiverId in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds &&
          request.resource.data.receiverId != request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /offers/{offerId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'productId',
          'buyerId',
          'sellerId',
          'participantIds',
          'listedPrice',
          'offeredPrice',
          'message',
          'productTitle',
          'productImage',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'productId',
          'buyerId',
          'sellerId',
          'participantIds',
          'listedPrice',
          'offeredPrice',
          'message',
          'productTitle',
          'productImage',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.sellerId != request.auth.uid &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.hasAll([
          request.resource.data.buyerId,
          request.resource.data.sellerId
        ]) &&
        exists(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ) &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.sellerId == request.resource.data.sellerId &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.status == 'Active' &&
        request.resource.data.listedPrice ==
          get(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          ).data.price &&
        request.resource.data.offeredPrice is number &&
        request.resource.data.offeredPrice > 0 &&
        request.resource.data.offeredPrice <= request.resource.data.listedPrice &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 500 &&
        request.resource.data.productTitle is string &&
        request.resource.data.productTitle.size() <= 120 &&
        request.resource.data.productImage is string &&
        request.resource.data.productImage.size() <= 2048 &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if signedIn() &&
        request.auth.uid == resource.data.sellerId &&
        resource.data.status == 'Pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]) &&
        request.resource.data.status in ['Accepted', 'Rejected'] &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'productId',
          'buyerId',
          'sellerId',
          'participantIds',
          'productTitle',
          'productImage',
          'sellerName',
          'price',
          'status',
          'fulfillmentMethod',
          'address',
          'paymentMethod',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'productId',
          'buyerId',
          'sellerId',
          'participantIds',
          'productTitle',
          'productImage',
          'sellerName',
          'price',
          'status',
          'fulfillmentMethod',
          'address',
          'paymentMethod',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.sellerId != request.auth.uid &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds.hasAll([
          request.resource.data.buyerId,
          request.resource.data.sellerId
        ]) &&
        exists(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ) &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.status == 'Active' &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.sellerId == request.resource.data.sellerId &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.price == request.resource.data.price &&
        get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.title == request.resource.data.productTitle &&
        request.resource.data.productImage ==
          (
            get(
              /databases/$(database)/documents/products/$(request.resource.data.productId)
            ).data.imageUrls.size() > 0
              ? get(
                  /databases/$(database)/documents/products/$(request.resource.data.productId)
                ).data.imageUrls[0]
              : ''
          ) &&
        request.resource.data.productTitle is string &&
        request.resource.data.productTitle.size() > 0 &&
        request.resource.data.productTitle.size() <= 120 &&
        request.resource.data.productImage is string &&
        request.resource.data.productImage.size() <= 2048 &&
        request.resource.data.sellerName is string &&
        request.resource.data.sellerName.size() <= 100 &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.fulfillmentMethod in ['Pickup', 'Delivery'] &&
        request.resource.data.address is string &&
        request.resource.data.address.size() > 0 &&
        request.resource.data.address.size() <= 300 &&
        request.resource.data.paymentMethod == 'Pay in person' &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time &&
        (
          (
            request.auth.uid == resource.data.sellerId &&
            resource.data.status == 'Pending' &&
            request.resource.data.status in ['Confirmed', 'Cancelled']
          ) ||
          (
            request.auth.uid == resource.data.sellerId &&
            resource.data.status == 'Confirmed' &&
            request.resource.data.status == 'Ready for pickup'
          ) ||
          (
            request.auth.uid == resource.data.sellerId &&
            resource.data.status == 'Ready for pickup' &&
            request.resource.data.status == 'Completed'
          ) ||
          (
            request.auth.uid == resource.data.buyerId &&
            resource.data.status == 'Pending' &&
            request.resource.data.status == 'Cancelled'
          )
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
